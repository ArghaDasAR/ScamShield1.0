{
  "version": 2,
  "buildCommand": "cd SenseCheckAI && npm install && npm run build",
  "outputDirectory": "SenseCheckAI/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
